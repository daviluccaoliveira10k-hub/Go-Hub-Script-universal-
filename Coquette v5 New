-- ==========================================
-- Utilidades
-- ==========================================
local function randomString(len)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local s = ""
    for _ = 1, len do
        local i = math.random(1, #chars)
        s = s .. chars:sub(i, i)
    end
    return s
end

local function getForward()
    local look = hrp.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, -1) end
    return flat.Unit
end

local function getCameraForward()
    local cam = workspace.CurrentCamera
    if not cam then return getForward() end
    local look = cam.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.1 then return getForward() end
    return flat.Unit
end

local function placeAlongY(part, pos, dir)
    local yAxis = dir.Unit
    local ref = Vector3.new(1, 0, 0)
    if math.abs(yAxis:Dot(ref)) > 0.95 then
        ref = Vector3.new(0, 0, 1)
    end
    local xAxis = ref:Cross(yAxis).Unit
    local zAxis = xAxis:Cross(yAxis).Unit
    part.CFrame = CFrame.fromMatrix(pos, xAxis, yAxis, zAxis)
end

