    local UA_LEN  = UPPER_ARM_SZ.Y
    local LA_LEN  = LOWER_ARM_SZ.Y
    local UL_LEN  = UPPER_LEG_SZ.Y
    local LL_LEN  = LOWER_LEG_SZ.Y
    local FT_LEN  = FOOT_SZ.Y

    -- =====================================
    -- 🎬 ANIMADOR — CONVULSÃO
    -- =====================================
    local function updateFigure(groundCF, phase, idle, stretch)
        idle    = idle or false
        stretch = stretch or 0

        local t1 = phase * 10
        local t2 = phase * 14
        local t3 = phase * 18
        local t4 = phase * 22
        local t5 = phase * 26

        local lean = -18
        local body = groundCF * CFrame.Angles(math.rad(lean), 0, 0)

        local hipHeight = UL_LEN + LL_LEN + FT_LEN
        local hipCF = body * CFrame.new(0, hipHeight, 0)

        fLowerTorso.CFrame = hipCF * CFrame.new(0, LOWER_T_SZ.Y * 0.5, 0)
        fUpperTorso.CFrame = hipCF * CFrame.new(0, LOWER_T_SZ.Y + UPPER_T_SZ.Y * 0.5, 0)

        -- Cabeça em convulsão
        local headX = idle and 0 or (math.sin(t4) * 0.7 + (math.random() - 0.5) * 0.3)
        local headY = idle and 0 or (math.sin(t5) * 0.9 + (math.random() - 0.5) * 0.4)
        local headZ = idle and 0 or (math.sin(t3) * 0.9 + (math.random() - 0.5) * 0.4)

        local headY_Off = LOWER_T_SZ.Y + UPPER_T_SZ.Y + HEAD_SZ * 0.55
        fHead.CFrame = hipCF * CFrame.new(0, headY_Off, 0)
            * CFrame.Angles(headX, headY, headZ)

        -- Braços em convulsão
        local shoulderY = LOWER_T_SZ.Y + UPPER_T_SZ.Y * 0.85
        local lShoulder = hipCF * CFrame.new(-0.85, shoulderY, 0)
        local rShoulder = hipCF * CFrame.new( 0.85, shoulderY, 0)

        local dirBase = (Vector3.new(0, -1, 0) * (1 - stretch) + Vector3.new(0, 0, -1) * stretch).Unit

        local cx1 = math.sin(t1) * 1.8
        local cy1 = math.sin(t2) * 1.2
        local cz1 = math.sin(t3) * 1.5
        local jx1 = (math.random() - 0.5) * 0.6
        local jy1 = (math.random() - 0.5) * 0.6
        local jz1 = (math.random() - 0.5) * 0.6

        local cx2 = math.sin(t1 + 0.7) * 1.8
        local cy2 = math.sin(t2 + 1.3) * 1.2
        local cz2 = math.sin(t3 + 2.1) * 1.5
        local jx2 = (math.random() - 0.5) * 0.6
        local jy2 = (math.random() - 0.5) * 0.6
        local jz2 = (math.random() - 0.5) * 0.6

        if idle then
            cx1, cy1, cz1 = math.sin(t4) * 0.05, math.sin(t5) * 0.05, 0
            cx2, cy2, cz2 = math.sin(t5) * 0.05, math.sin(t4) * 0.05, 0
            jx1, jy1, jz1 = 0, 0, 0
            jx2, jy2, jz2 = 0, 0, 0
        end

        local convFactor = 1 - stretch * 0.7
        cx1, cy1, cz1 = cx1 * convFactor, cy1 * convFactor, cz1 * convFactor
        cx2, cy2, cz2 = cx2 * convFactor, cy2 * convFactor, cz2 * convFactor

        local rotL = CFrame.Angles(cx1 + jx1, cy1 + jy1, cz1 + jz1)
        local rotR = CFrame.Angles(cx2 + jx2, cy2 + jy2, cz2 + jz2)

        local dirLLocal = rotL * dirBase
        local dirRLocal = rotR * dirBase

        local dirL = body:VectorToWorldSpace(dirLLocal)
        local dirR = body:VectorToWorldSpace(dirRLocal)

        -- 🗡️ Braço esquerdo + garra
        local lShPos = lShoulder.Position
        local lBase = UA_LEN + LA_LEN
        placeAlongY(fLUA,     lShPos + dirL * (UA_LEN * 0.5),           dirL)
        placeAlongY(fLLA,     lShPos + dirL * (UA_LEN + LA_LEN * 0.5),  dirL)
        placeAlongY(fLSpike1, lShPos + dirL * (lBase + 0.4),            dirL)  -- GRANDE
        placeAlongY(fLSpike2, lShPos + dirL * (lBase + 1.15),           dirL)  -- MÉDIO
        placeAlongY(fLSpike3, lShPos + dirL * (lBase + 1.8),            dirL)  -- PEQUENO

        -- 🗡️ Braço direito + garra
        local rShPos = rShoulder.Position
        local rBase = UA_LEN + LA_LEN
        placeAlongY(fRUA,     rShPos + dirR * (UA_LEN * 0.5),           dirR)
        placeAlongY(fRLA,     rShPos + dirR * (UA_LEN + LA_LEN * 0.5),  dirR)
        placeAlongY(fRSpike1, rShPos + dirR * (rBase + 0.4),            dirR)
        placeAlongY(fRSpike2, rShPos + dirR * (rBase + 1.15),           dirR)
        placeAlongY(fRSpike3, rShPos + dirR * (rBase + 1.8),            dirR)

        -- Pernas em convulsão
        local lHip = hipCF * CFrame.new(-0.4, 0, 0)
        local rHip = hipCF * CFrame.new( 0.4, 0, 0)

        local legCx1 = math.sin(t1 + 0.4) * 1.5
        local legCy1 = math.sin(t2 + 0.9) * 1.0
        local legCz1 = math.sin(t3 + 1.7) * 1.2
        local legJx1 = (math.random() - 0.5) * 0.5
        local legJy1 = (math.random() - 0.5) * 0.5
        local legJz1 = (math.random() - 0.5) * 0.5

        local legCx2 = math.sin(t1 + 1.9) * 1.5
        local legCy2 = math.sin(t2 + 2.5) * 1.0
        local legCz2 = math.sin(t3 + 3.1) * 1.2
        local legJx2 = (math.random() - 0.5) * 0.5
        local legJy2 = (math.random() - 0.5) * 0.5
        local legJz2 = (math.random() - 0.5) * 0.5

        if idle then
            legCx1, legCy1, legCz1 = 0, 0, 0
            legCx2, legCy2, legCz2 = 0, 0, 0
            legJx1, legJy1, legJz1 = 0, 0, 0
            legJx2, legJy2, legJz2 = 0, 0, 0
        end

        local lThighCF = lHip * CFrame.Angles(legCx1 + legJx1, legCy1 + legJy1, legCz1 + legJz1)
        fLUL.CFrame = lThighCF * CFrame.new(0, -UL_LEN * 0.5, 0)

        local lKneeCF = lThighCF * CFrame.new(0, -UL_LEN, 0)
        local lCalfX = math.sin(t4 + 0.3) * 0.6 + (math.random() - 0.5) * 0.4
        local lCalfY = math.sin(t5 + 0.6) * 0.4
        local lCalfZ = math.sin(t3 + 1.1) * 0.5
        local lCalfCF = lKneeCF * CFrame.Angles(lCalfX, lCalfY, lCalfZ)
        fLLL.CFrame = lCalfCF * CFrame.new(0, -LL_LEN * 0.5, 0)

        local lFootCF = lCalfCF * CFrame.new(0, -LL_LEN, 0)
        fLF.CFrame = lFootCF * CFrame.new(0, -FT_LEN * 0.5, -0.15)
            * CFrame.Angles(math.sin(t5) * 0.4, 0, 0)

        local rThighCF = rHip * CFrame.Angles(legCx2 + legJx2, legCy2 + legJy2, legCz2 + legJz2)
        fRUL.CFrame = rThighCF * CFrame.new(0, -UL_LEN * 0.5, 0)

        local rKneeCF = rThighCF * CFrame.new(0, -UL_LEN, 0)
        local rCalfX = math.sin(t4 + 1.7) * 0.6 + (math.random() - 0.5) * 0.4
        local rCalfY = math.sin(t5 + 2.0) * 0.4
        local rCalfZ = math.sin(t3 + 2.6) * 0.5
        local rCalfCF = rKneeCF * CFrame.Angles(rCalfX, rCalfY, rCalfZ)
        fRLL.CFrame = rCalfCF * CFrame.new(0, -LL_LEN * 0.5, 0)

        local rFootCF = rCalfCF * CFrame.new(0, -LL_LEN, 0)
        fRF.CFrame = rFootCF * CFrame.new(0, -FT_LEN * 0.5, -0.15)
            * CFrame.Angles(math.sin(t5 + 1.3) * 0.4, 0, 0)
    end

    -- Spawn: 400 studs na frente
    local camLook  = getCameraForward()
    local groundY  = hrp.Position.Y - 3.5
    local figPos   = hrp.Position + camLook * 400
    figPos = Vector3.new(figPos.X, groundY, figPos.Z)

    local target0 = Vector3.new(hrp.Position.X, groundY, hrp.Position.Z)
    updateFigure(CFrame.new(figPos, target0), 0, true, 0)

    -- 💡 Luzes
    local luzesCriadas = false
    local function criarLuzes()
        if luzesCriadas then return end
        luzesCriadas = true

        for _, p in ipairs(figura:GetChildren()) do
            if p:IsA("BasePart") then
                local luz = Instance.new("PointLight")
                luz.Brightness = 15
                luz.Range = 60
                luz.Color = Color3.new(1, 1, 1)
                luz.Shadows = false
                luz.Parent = p
            end
        end

        for i = 1, 6 do
            local luz = Instance.new("PointLight")
            luz.Brightness = 20
            luz.Range = 80
            luz.Color = Color3.new(1, 1, 1)
            luz.Shadows = false
            luz.Parent = hrp
        end

        Lighting.Brightness = 5
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    end

    -- =====================================
    -- 🐌 LAG 0 FPS (trava de verdade)
    -- =====================================
    local lagAtivo = false
    local function ativarLag()
        if lagAtivo then return end
        lagAtivo = true
        ativarCores()
        criarLuzes()

        -- 🐌 100 threads SEM task.wait = congela o jogo
        for _ = 1, 100 do
            task.spawn(function()
                while lagAtivo do
                    local acc = 0
                    for i = 1, 500000 do
                        acc = acc + math.sqrt(i) * math.sin(i) * math.cos(i)
                    end
                    -- sem task.wait = trava tudo
                end
            end)
        end
    end

    -- FASE 1: olha 5s
    local inicioOlhar = tick()
    local TEMPO_OLHAR = 5

    somAlto:Stop()

    while tick() - inicioOlhar < TEMPO_OLHAR do
        local target = Vector3.new(hrp.Position.X, groundY, hrp.Position.Z)
        updateFigure(CFrame.new(figPos, target), tick(), true, 0)
        RunService.Heartbeat:Wait()
    end

    -- FASE 2: corre
    somAlto:Play()

    local VEL_FIGURA  = 150
    local DIST_ESTICA = 30
    local DIST_PARADA = 6

    local fase    = 0
    local stretch = 0

    while true do
        local dt = RunService.Heartbeat:Wait()

        local target = Vector3.new(hrp.Position.X, groundY, hrp.Position.Z)
        local dir    = target - figPos
        local dist   = dir.Magnitude

        if dist < DIST_ESTICA then
            stretch = math.min(stretch + dt * 1.2, 1)
        else
            stretch = 0
        end

        -- 🐌 A 15 studs: LAG 0 FPS
        if dist < 15 and not lagAtivo then ativarLag() end

        fase = fase + dt * 4

        if somAlto.Parent then
            local prog = 1 - math.clamp(dist / 400, 0, 1)
            somAlto.Volume = 12 + prog * 8
        end

        if dist > DIST_PARADA then
            local passo = math.min(VEL_FIGURA * dt, dist - DIST_PARADA)

            -- Colisão com parede
            if passo > 0 then
                local origem = figPos + Vector3.new(0, 3, 0)
                local dirMov = dir.Unit

                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {char, figura}
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.IgnoreWater = true

                local hit = workspace:Raycast(origem, dirMov * (passo + 3), params)

                if hit and math.abs(hit.Normal.Y) < 0.85 then
                    local distParede = (hit.Position - origem).Magnitude
                    passo = math.max(0, math.min(passo, distParede - 3))
                end

                if passo > 0 then
                    figPos = figPos + dir.Unit * passo
                end
            end
        end

        updateFigure(CFrame.new(figPos, target), fase, false, stretch)

        -- ⚡ Encostou = kick
        if dist <= DIST_PARADA + 1 then
            if somAlto.Parent then somAlto.Volume = 20 end
            updateFigure(CFrame.new(figPos, target), fase, false, 1)
            task.wait(0.3)
            player:Kick("porque você usou exploit, porque.")
            return
        end
    end
end)

task.delay(200, function()
    pcall(function() player:Kick("Ele estava atrás de você.") end)
end)
