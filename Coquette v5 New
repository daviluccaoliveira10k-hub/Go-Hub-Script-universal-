-- ☁️ Céu
local atmosfera = nil
local function configurarCeu()
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky then sky:Destroy() end
    atmosfera = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atmosfera then
        atmosfera = Instance.new("Atmosphere")
        atmosfera.Density = 0.5
        atmosfera.Parent  = Lighting
    end
end

-- 💬 Esconder UI
local function esconderUI()
    pcall(function()
        local sg = game:GetService("StarterGui")
        sg:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
        sg:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
    end)
end

-- 👥 Sumir outros players
local function sumirTudo()
    for _, outro in ipairs(Players:GetPlayers()) do
        if outro ~= player and outro.Character then
            local c = outro.Character
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Transparency = 1
                    p.CanCollide = false
                    p.CastShadow = false
                elseif p:IsA("Decal") or p:IsA("Texture") then
                    p.Transparency = 1
                end
            end
            local head = c:FindFirstChild("Head")
            if head then
                for _, v in ipairs(head:GetChildren()) do
                    if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                        v:Destroy()
                    end
                end
            end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("Accessory") or p:IsA("Shirt") or p:IsA("Pants")
                   or p:IsA("ShirtGraphic") or p:IsA("CharacterMesh") or p:IsA("Hat") then
                    pcall(function() p:Destroy() end)
                end
            end
            local hl = c:FindFirstChildOfClass("Highlight")
            if hl then hl:Destroy() end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
        end
    end
end

Players.PlayerAdded:Connect(function(novo)
    novo.CharacterAdded:Connect(function()
        task.wait(1)
        sumirTudo()
    end)
end)

-- ==========================================
-- Construtor humanóide
-- ==========================================
local function buildHumanoid(name, color, neon)
    local model = Instance.new("Model")
    model.Name = name
    local h = Instance.new("Humanoid")
    h.Parent = model
    h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

    local function mk(pname, size)
        local p = Instance.new("Part")
        p.Name = pname
        p.Size = size
        p.Color = color
        p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
        p.Anchored = false
        p.CanCollide = false
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        p.Parent = model
        return p
    end

    local hrpP = mk("HumanoidRootPart", Vector3.new(2,2,1))
    hrpP.Transparency = 1
    hrpP.Anchored = true

    local parts = {
        LowerTorso    = mk("LowerTorso",    Vector3.new(2, 1.2, 1)),
        UpperTorso    = mk("UpperTorso",    Vector3.new(2, 1.6, 1)),
        Head          = mk("Head",          Vector3.new(1.5, 1.5, 1.5)),
        LeftUpperArm  = mk("LeftUpperArm",  Vector3.new(1, 1.2, 1)),
        LeftLowerArm  = mk("LeftLowerArm",  Vector3.new(1, 1.1, 1)),
        LeftHand      = mk("LeftHand",      Vector3.new(1, 0.5, 1)),
        RightUpperArm = mk("RightUpperArm", Vector3.new(1, 1.2, 1)),
        RightLowerArm = mk("RightLowerArm", Vector3.new(1, 1.1, 1)),
        RightHand     = mk("RightHand",     Vector3.new(1, 0.5, 1)),
        LeftUpperLeg  = mk("LeftUpperLeg",  Vector3.new(1, 1.4, 1)),
        LeftLowerLeg  = mk("LeftLowerLeg",  Vector3.new(1, 1.3, 1)),
        LeftFoot      = mk("LeftFoot",      Vector3.new(1, 0.4, 1.4)),
        RightUpperLeg = mk("RightUpperLeg", Vector3.new(1, 1.4, 1)),
        RightLowerLeg = mk("RightLowerLeg", Vector3.new(1, 1.3, 1)),
        RightFoot     = mk("RightFoot",     Vector3.new(1, 0.4, 1.4)),
    }
    parts.Head.Shape = Enum.PartType.Ball
    model.PrimaryPart = hrpP

    local function weld(a, b)
        local w = Instance.new("WeldConstraint")
        w.Part0 = a; w.Part1 = b; w.Parent = a
    end

    local offsets = {
        LowerTorso    = Vector3.new(0, -0.2, 0),
        UpperTorso    = Vector3.new(0,  1.0, 0),
        Head          = Vector3.new(0,  2.5, 0),
        LeftUpperArm  = Vector3.new(-1.5,  1.2, 0),
        LeftLowerArm  = Vector3.new(-1.5,  0.0, 0),
        LeftHand      = Vector3.new(-1.5, -0.8, 0),
        RightUpperArm = Vector3.new( 1.5,  1.2, 0),
        RightLowerArm = Vector3.new( 1.5,  0.0, 0),
        RightHand     = Vector3.new( 1.5, -0.8, 0),
        LeftUpperLeg  = Vector3.new(-0.5, -1.4, 0),
        LeftLowerLeg  = Vector3.new(-0.5, -2.8, 0),
        LeftFoot      = Vector3.new(-0.5, -3.9, 0.3),
        RightUpperLeg = Vector3.new( 0.5, -1.4, 0),
        RightLowerLeg = Vector3.new( 0.5, -2.8, 0),
        RightFoot     = Vector3.new( 0.5, -3.9, 0.3),
    }

    for pname, part in pairs(parts) do
        part.CFrame = hrpP.CFrame * CFrame.new(offsets[pname])
        weld(hrpP, part)
    end

    return model, hrpP, parts
end

-- 🌈 Cores caóticas
local coresAtivo = false
local function ativarCores()
    if coresAtivo then return end
    coresAtivo = true
    configurarCeu()
    task.spawn(function()
        local paleta = {
            Color3.new(1, 0, 0), Color3.new(0, 0, 1), Color3.new(0, 1, 0),
            Color3.new(0.6, 0, 1), Color3.new(1, 1, 0), Color3.new(1, 0, 1),
            Color3.new(0, 1, 1),
        }
        while coresAtivo do
            local cor = paleta[math.random(1, #paleta)]
            Lighting.Ambient         = cor
            Lighting.OutdoorAmbient  = cor
            Lighting.FogColor        = cor
            Lighting.Brightness      = 3
            if atmosfera then
                atmosfera.Color = cor
                atmosfera.Decay = cor
            end
            ccEffect.TintColor = cor
            task.wait(0.05)
        end
    end)
end

