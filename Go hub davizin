--==================================================

local function CreateCube()

	local Cube = Instance.new("Frame")

	local Size = Random:NextNumber(12, 34)

	Cube.Size = UDim2.fromOffset(Size, Size)

	Cube.Position = UDim2.fromScale(
		Random:NextNumber(0, 1),
		Random:NextNumber(0, 1)
	)

	Cube.BackgroundColor3 = Color3.fromRGB(
		Random:NextInteger(25, 70),
		Random:NextInteger(130, 200),
		255
	)

	Cube.BackgroundTransparency = Random:NextNumber(0.25, 0.55)
	Cube.BorderSizePixel = 0
	Cube.Rotation = Random:NextNumber(0, 360)

	-- Acima do fundo
	Cube.ZIndex = 2
	Cube.Parent = Background

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 5)
	Corner.Parent = Cube

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(70, 190, 255)
	Stroke.Thickness = 1
	Stroke.Transparency = 0.25
	Stroke.Parent = Cube

	--==================================================
	-- MOVIMENTO ZERO GRAVITY
	--==================================================

	task.spawn(function()

		while Cube.Parent do

			local Current = Cube.Position

			local OffsetX = Random:NextNumber(-0.10, 0.10)
			local OffsetY = Random:NextNumber(-0.08, 0.08)

			local TargetX = math.clamp(
				Current.X.Scale + OffsetX,
				-0.05,
				1.05
			)

			local TargetY = math.clamp(
				Current.Y.Scale + OffsetY,
				-0.05,
				1.05
			)

			local Duration = Random:NextNumber(8, 16)

			local Tween = TweenService:Create(
				Cube,
				TweenInfo.new(
					Duration,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.fromScale(
						TargetX,
						TargetY
					),

					Rotation =
						Cube.Rotation
						+ Random:NextNumber(20, 70)
				}
			)

			Tween:Play()
			Tween.Completed:Wait()

			task.wait(
				Random:NextNumber(0.3, 1.5)
			)

		end

	end)

	--==================================================
	-- PULSAÇÃO
	--==================================================

	task.spawn(function()

		while Cube.Parent do

			local Fade = TweenService:Create(
				Cube,
				TweenInfo.new(
					Random:NextNumber(3, 6),
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					BackgroundTransparency =
						Random:NextNumber(0.25, 0.55)
				}
			)

			Fade:Play()
			Fade.Completed:Wait()

		end

	end)
end

-- Criar cubos
for i = 1, CUBE_COUNT do
	CreateCube()
end

