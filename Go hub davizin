		end

		Log.Text = table.concat(
			Logs,
			"\n"
		)

		TweenService:Create(
			Bar,
			TweenInfo.new(
				LOAD_TIME / #Steps,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.fromScale(
					Progress,
					1
				)
			}
		):Play()

